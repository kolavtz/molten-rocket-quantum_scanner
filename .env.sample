# Application / security
QSS_ENV=
QSS_DEBUG=
QSS_SECRET_KEY=
QSS_ENCRYPTION_KEY=
QSS_AUDIT_HASH_SECRET=
QSS_REQUIRE_2FA=
QSS_REQUIRE_2FA_ROLES=
QSS_2FA_DEV_BYPASS=
DEBUG_LOGIN_BYPASS=

# Database
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# AI assistant configuration (server-side)
QSS_AI_MODEL_BACKEND=llama_cpp
QSS_AI_MODEL_PATH=models/llama-7b-q4_0.bin
QSS_AI_MAX_TOKENS=512
QSS_AI_TEMPERATURE=0.2
QSS_AI_MAX_CONTEXT_TOKENS=2048
QSS_AI_USE_RAG=false
QSS_RAG_DB_PATH=data/ai_rag.db
QSS_AI_STREAMING_ENABLED=true
QSS_RUN_REAL_MODEL_TESTS=0
