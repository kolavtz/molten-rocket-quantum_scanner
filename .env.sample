# QuantumShield example environment file
# Copy this to .env and fill in real values (DO NOT commit .env with secrets).

# ---------------------------------------------------------------------------
# Flask / App
# ---------------------------------------------------------------------------
QSS_ENV=development
QSS_DEBUG=true
QSS_SECRET_KEY=
QSS_ENCRYPTION_KEY=
QSS_AUDIT_HASH_SECRET=
QSS_SESSION_COOKIE_NAME=quantumshield_session
QSS_SESSION_IDLE_TIMEOUT_SECONDS=3600
QSS_FORCE_HTTPS=true
QSS_TRUST_PROXY_SSL=true
QSS_HSTS_SECONDS=31536000
QSS_HTTP_REDIRECT_PORT=5080

# Authentication / policy
QSS_INVALID_USERNAME_LOCKOUT_ATTEMPTS=3
QSS_MAX_LOGIN_ATTEMPTS=3
QSS_LOGIN_LOCKOUT_MINUTES=15
QSS_REQUIRE_2FA=false
QSS_REQUIRE_2FA_ROLES=Admin,Manager
QSS_2FA_DEV_BYPASS=false
DEBUG_LOGIN_BYPASS=false

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT_LIMITS=9000 per day,3000 per hour
RATELIMIT_STORAGE_URI=memory://

# ---------------------------------------------------------------------------
# Network binding
# ---------------------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=db_local
MYSQL_PASSWORD=
MYSQL_DATABASE=quantumshield_v2

# ---------------------------------------------------------------------------
# SMTP / Email
# ---------------------------------------------------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

SMTP_SERVER=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Admin bootstrap
# ---------------------------------------------------------------------------
# Do NOT set a real admin password in source control.
QSS_ADMIN_USERNAME=Admin
QSS_ADMIN_EMAIL=admin@example.com
QSS_ADMIN_EMPLOYEE_ID=ADMIN-001
QSS_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Auto-update (runtime startup updater)
# ---------------------------------------------------------------------------
# If true, app checks origin/<QSS_GIT_BRANCH> at startup.
QSS_AUTO_UPDATE_ON_START=false
# If true, app may run: git reset --hard origin/<branch> (requires clean working tree).
QSS_ALLOW_AUTO_PULL=false
# Branch compared by startup updater.
QSS_GIT_BRANCH=main

# ---------------------------------------------------------------------------
# GitHub Release Update Manager
# ---------------------------------------------------------------------------
QSS_GITHUB_REPO_OWNER=your-github-org-or-user
QSS_GITHUB_REPO_NAME=your-repository-name
QSS_GITHUB_RELEASES_API_URL=https://api.github.com/repos/your-github-org-or-user/your-repository-name/releases/latest
QSS_GITHUB_UPDATE_ENABLED=false
QSS_GITHUB_UPDATE_ON_START=false
QSS_GITHUB_UPDATE_SCHEDULED=false
QSS_GITHUB_UPDATE_INTERVAL_MINUTES=60
QSS_GITHUB_RELEASE_ASSET_NAME=
QSS_GITHUB_TOKEN=
QSS_ALLOW_AUTO_UPDATE=false

# ---------------------------------------------------------------------------
# AI / Agent Configuration
# ---------------------------------------------------------------------------
AI_SERVER_URL=http://127.0.0.1:1234
AI_SERVER_API_KEY=
QSS_AI_SYSTEM_PROMPT=You are the QuantumShield assistant. Provide concise, factual, and actionable security guidance based on any scan data supplied.
QSS_AI_USE_RAG=true
QSS_AI_MAX_TOKENS=4096
QSS_AI_TEMPERATURE=0.2

# Optional local model backend settings
QSS_AI_MODEL_BACKEND=
QSS_AI_MODEL_PATH=

# Optional external agent orchestrator settings
QSS_AGENT_ENABLED=false
QSS_AGENT_BACKEND_URL=
QSS_AGENT_PORT=9000
